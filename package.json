{
  "name": "@automation-architecture/signatures",
  "version": "0.1.0",
  "private": true,
  "description": "Reusable self-hosted e-signature flow for AAA apps: non-embedded, identity-bound signature requests with an ESIGN/UETA-oriented audit trail.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "schema.sql"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "start": "node dist/server/main.js",
    "dev": "node --experimental-strip-types --env-file=.env src/server/main.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "nodemailer": "^10.0.10",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0"
  }
}
